{
  "name": "typed-sql-workspace",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lojhan/typed-sql.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "build": "node scripts/require-typescript-7.mjs && tsc -b && pnpm --filter @typed-sql/vscode build:bundle",
    "changeset": "changeset",
    "verify": "pnpm test && pnpm build",
    "clean": "tsc -b --clean",
    "e2e:postgres": "pnpm build && pnpm --filter @typed-sql/e2e-postgres e2e",
    "test": "pnpm typecheck && poku --config=poku.config.js --reporter=compact --enforce",
    "test:watch": "poku --config=poku.config.js --watch",
    "typecheck": "node scripts/require-typescript-7.mjs && tsc -b --pretty false",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "poku": "4.5.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
