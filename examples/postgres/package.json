{
  "name": "@typed-sql/example-postgres",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable PostgreSQL example using typed-sql from the current workspace.",
  "type": "module",
  "scripts": {
    "db:up": "node ../compose.mjs up",
    "db:down": "node ../compose.mjs down",
    "generate": "node ../../packages/cli/dist/packages/cli/src/cli.js generate --config typed-sql.config.ts",
    "generate:snapshot": "node ../../packages/cli/dist/packages/cli/src/cli.js generate --config typed-sql.config.ts --snapshot schema/catalog.snapshot.json",
    "check": "node ../../packages/cli/dist/packages/cli/src/cli.js check --config typed-sql.config.ts --file src/queries.ts --project tsconfig.json",
    "start": "tsx src/main.ts",
    "test": "poku test --reporter=compact --enforce"
  },
  "dependencies": {
    "@typed-sql/core": "workspace:*",
    "@typed-sql/postgres": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@typed-sql/cli": "workspace:*",
    "@typed-sql/language-server": "workspace:*",
    "poku": "4.5.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
