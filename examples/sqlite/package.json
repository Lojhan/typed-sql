{
  "name": "@typed-sql/example-sqlite",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable SQLite example using typed-sql from the current workspace.",
  "type": "module",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "generate": "pnpm run setup && node ../../packages/cli/dist/packages/cli/src/cli.js generate --config typed-sql.config.ts",
    "generate:snapshot": "node ../../packages/cli/dist/packages/cli/src/cli.js generate --config typed-sql.config.ts --snapshot schema/catalog.snapshot.json",
    "check": "node ../check.mjs",
    "start": "pnpm run setup && tsx src/main.ts",
    "test": "poku test --reporter=compact --enforce",
    "test:database": "pnpm run setup && poku database-test --reporter=compact --enforce"
  },
  "dependencies": {
    "@typed-sql/core": "workspace:*",
    "@typed-sql/sqlite": "workspace:*",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@typed-sql/cli": "workspace:*",
    "@typed-sql/conformance": "workspace:*",
    "@typed-sql/language-server": "workspace:*",
    "poku": "4.5.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
