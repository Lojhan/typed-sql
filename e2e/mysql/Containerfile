# Local runs retain the immutable 8.4.11 default. The differential matrix supplies an exact tagged
# Oracle MySQL image so each evidence artifact records the version that CI actually executed.
ARG MYSQL_BASE_IMAGE=docker.io/library/mysql@sha256:b3b90af2a6552ae30c266fdb7d5dd55f3afb72404bb78d37fe8a23eb857fd3fb
FROM ${MYSQL_BASE_IMAGE}

COPY schema/001-schema.sql /docker-entrypoint-initdb.d/001-schema.sql
COPY schema/002-seed.sql /docker-entrypoint-initdb.d/002-seed.sql
