# The local default is the latest stable matrix target. CI supplies the exact image selected for
# each supported major and the next-major canary through this build argument.
ARG POSTGRES_IMAGE=docker.io/library/postgres:18.6-bookworm
FROM ${POSTGRES_IMAGE}

COPY schema/001-schema.sql /docker-entrypoint-initdb.d/001-schema.sql
COPY schema/002-seed.sql /docker-entrypoint-initdb.d/002-seed.sql
