{
  "name": "@typed-sql/e2e-postgres",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "e2e": "tsc --project tsconfig.test.json --noEmit --pretty false && poku --config=poku.config.js --reporter=compact --enforce",
    "generate": "typed-sql generate --provider postgres --url postgresql://typed_sql:typed_sql_e2e@127.0.0.1:55432/typed_sql_e2e --schemas public --out generated/db",
    "generate:snapshot": "typed-sql generate --snapshot schema/catalog.snapshot.json --out generated/db",
    "check": "typed-sql check --file src/query.ts --schema generated/db/schema.json --project tsconfig.json",
    "drift": "typed-sql drift --schema generated/db/schema.json --provider postgres --url postgresql://typed_sql:typed_sql_e2e@127.0.0.1:55432/typed_sql_e2e --schemas public"
  },
  "dependencies": {
    "@typed-sql/cli": "workspace:*",
    "@typed-sql/runtime": "workspace:*",
    "@typed-sql/ts-bridge": "workspace:*"
  },
  "devDependencies": {
    "poku": "4.5.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
