  "workloads": [
    {
      "scenario": "string parameters",
      "sql": "SELECT concat_ws(' ', lower($1::text), upper($2::text)) AS label"
    },
    {
      "scenario": "numeric precision",
      "sql": "SELECT round(12.345::numeric, 2) AS amount, abs(-42) AS magnitude"
    },
    {
      "scenario": "null handling",
      "sql": "SELECT coalesce(NULL::text, 'fallback') AS label, nullif(1, 2) AS value"
    },
    {
      "scenario": "date calculation",
      "sql": "SELECT date_trunc('day', now()) AS day, make_interval(days => 1) AS duration"
    },
    {
      "scenario": "JSON construction",
      "sql": "SELECT jsonb_build_object('id', 1, 'label', 'x') AS payload"
    },
    {
      "scenario": "array construction",
      "sql": "SELECT array_append(ARRAY[1, 2], 3) AS items, cardinality(ARRAY[1, 2]) AS size"
    },
    {
      "scenario": "aggregation",
      "sql": "SELECT count(*) AS row_count, sum(value) AS total FROM (SELECT 1 AS value UNION ALL SELECT 2 AS value) AS items"
    },
    {
      "scenario": "window ranking",
      "sql": "SELECT row_number() OVER (ORDER BY value) AS ordinal FROM (SELECT 1 AS value) AS items"
    },
    {
      "scenario": "table routine",
      "sql": "SELECT * FROM generate_series(1, 3) AS series(value)"
    }
  ]
