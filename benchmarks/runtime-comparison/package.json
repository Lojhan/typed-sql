{
  "name": "@typed-sql/benchmark-runtime-comparison",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "databases:start": "node scripts/databases.mjs start",
    "databases:stop": "node scripts/databases.mjs stop",
    "generate": "prisma generate",
    "benchmark": "tsx src/benchmark.ts",
    "typecheck": "tsc --noEmit",
    "run": "pnpm databases:start && pnpm generate && pnpm benchmark"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@typed-sql/mysql": "link:../../packages/mysql",
    "@typed-sql/postgres": "link:../../packages/postgres",
    "drizzle-orm": "0.45.2",
    "kysely": "0.29.5",
    "mysql2": "3.24.1",
    "pg": "8.23.0",
    "typeorm": "1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config@7.10.0>deepmerge-ts": "8.0.2"
    }
  }
}
