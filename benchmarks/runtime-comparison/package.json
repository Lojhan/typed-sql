{
  "name": "@typed-sql/benchmark-runtime-comparison",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "databases:start": "node scripts/databases.mjs start",
    "databases:stop": "node scripts/databases.mjs stop",
    "generate": "prisma generate",
    "benchmark": "tsx src/benchmark.ts",
    "benchmark:bulk": "tsx src/bulk.ts",
    "benchmark:sqlite": "node src/runtime.mjs",
    "benchmark:postgres": "node src/runtime.mjs postgres",
    "benchmark:mysql": "node src/runtime.mjs mysql",
    "typecheck": "tsc --noEmit",
    "run": "pnpm databases:start && pnpm generate && pnpm benchmark && pnpm benchmark:bulk"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@typed-sql/mysql": "link:../../packages/mysql",
    "@typed-sql/postgres": "link:../../packages/postgres",
    "@typed-sql/sqlite": "link:../../packages/sqlite",
    "@typed-sql/ts-bridge": "link:../../packages/ts-bridge",
    "@reylosql/sqlite": "0.6.0",
    "@reylosql/postgres": "0.6.0",
    "@reylosql/mysql": "0.6.0",
    "drizzle-orm": "0.45.2",
    "kysely": "0.29.5",
    "mysql2": "3.24.3",
    "pg": "8.23.0",
    "pg-copy-streams": "7.0.0",
    "reylo": "0.6.0",
    "typeorm": "1.1.0",
    "@typed-sql/compiler": "link:../../packages/compiler"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "8.23.1",
    "@types/pg-copy-streams": "1.2.5",
    "prisma": "7.10.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config@7.10.0>deepmerge-ts": "8.0.2",
      "mysql2@>=3 <3.24.3": "3.24.3",
      "fast-uri@>=3 <3.1.9": "3.1.9"
    }
  }
}
