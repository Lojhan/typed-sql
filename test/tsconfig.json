{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "rootDir": ".."
  },
  "include": [
    "../scripts/language-audit/**/*.ts",
    "../scripts/language-audit/**/*.mjs",
    "../scripts/catalog-generation/**/*.ts",
    "../scripts/catalog-generation/**/*.mjs",
    "../tools/grammar-catalog/src/**/*.mjs",
    "../tools/grammar-catalog/src/**/*.ts",
    "../packages/*/test/**/*.test.ts",
    "../editors/vscode/test/**/*.test.ts",
    "../packages/*/test/helpers/**/*.ts",
    "../packages/*/test/environment.ts",
    "../packages/playground/ui/layout.ts",
    "../packages/playground/ui/explorer-model.ts",
    "../packages/playground/ui/object-definition-model.ts",
    "../packages/playground/ui/explorer-types.ts",
    "../packages/playground/ui/command-model.ts",
    "../packages/playground/ui/editor-language-model.ts",
    "../packages/playground/ui/editor-document.ts",
    "../packages/playground/ui/document-state.ts",
    "../packages/playground/ui/result-model.ts",
    "../packages/playground/ui/types.ts",
    "contracts/**/*.test.ts",
    "fuzz/**/*.ts",
    "grammar/**/*.ts",
    "helpers/**/*.ts",
    "soundness/**/*.ts",
    "../website/.vitepress/theme/playground/**/*.ts",
    "../examples/shared/**/*.ts"
