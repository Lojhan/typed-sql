    { "path": "../packages/postgres" },
    { "path": "../packages/mysql" },
    { "path": "../packages/sqlite" },
    { "path": "../packages/compiler" },
    { "path": "../packages/conformance" },
    { "path": "../packages/opentelemetry" },
    { "path": "../packages/cli" },
    { "path": "../packages/ts-bridge" },
    { "path": "../packages/language-server" },
    { "path": "../examples/synthetic-grammar" }
  ]
}
