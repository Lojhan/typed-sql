{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".."
  },
  "include": [
    "../packages/*/test/**/*.test.ts",
    "../packages/*/test/helpers/**/*.ts",
    "contracts/**/*.test.ts",
    "fuzz/**/*.ts",
    "grammar/**/*.ts",
    "helpers/**/*.ts",
    "soundness/**/*.ts",
    "../website/.vitepress/theme/playground/**/*.ts"
