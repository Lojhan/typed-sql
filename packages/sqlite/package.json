{
  "name": "@typed-sql/sqlite",
  "version": "3.0.0-rc.0",
  "description": "SQLite grammar, sound schema introspection, type resolution, and optional application-owned adapters for typed-sql.",
  "license": "MIT",
  "author": "Lojhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lojhan/typed-sql.git",
    "directory": "packages/sqlite"
  },
  "homepage": "https://github.com/Lojhan/typed-sql#readme",
  "bugs": {
    "url": "https://github.com/Lojhan/typed-sql/issues"
  },
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SQLITE_VOCABULARY_NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typedSql": {
    "releaseTrack": "stable",
    "developmentEntrypoints": [
      "./analysis",
      "./node-sqlite-contracts",
      "./reconciliation",
      "./analysis/core"
    ]
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "test": "poku test --sequential --coverage=@pokujs/c8 --coverageConfig=.c8rc.json --reporter=compact --enforce",
    "test:soundness": "poku test/soundness.test.ts --reporter=compact --enforce",
    "coverage": "pnpm test"
  },
  "exports": {
    ".": "./dist/packages/sqlite/src/index.js",
    "./runtime": "./dist/packages/sqlite/src/runtime.js",
    "./node-sqlite": "./dist/packages/sqlite/src/node-sqlite.js",
    "./query": "./dist/packages/sqlite/src/query.js",
    "./profile": "./dist/packages/sqlite/src/profile.js",
    "./analysis": "./dist/packages/sqlite/src/analysis.js",
    "./contract-profile": "./dist/packages/sqlite/src/contract-profile.js",
    "./node-sqlite-contracts": "./dist/packages/sqlite/src/node-sqlite-contracts.js",
    "./reconciliation": "./dist/packages/sqlite/src/reconciliation.js",
    "./analysis/core": "./dist/packages/sqlite/src/analysis/core.js"
  },
  "dependencies": {
    "@typed-sql/ast": "workspace:*",
    "@typed-sql/core": "workspace:*",
    "@typed-sql/schema": "workspace:*",
    "@typed-sql/analysis": "workspace:*"
  },
  "devDependencies": {
    "@typed-sql/conformance": "workspace:*"
  }
}
