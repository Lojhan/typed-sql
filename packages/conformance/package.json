{
  "name": "@typed-sql/conformance",
  "version": "2.3.0-rc.1",
  "description": "Public grammar, capability, codec, and performance conformance kit for typed-sql dialects.",
  "license": "MIT",
  "author": "Lojhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lojhan/typed-sql.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/Lojhan/typed-sql#readme",
  "bugs": {
    "url": "https://github.com/Lojhan/typed-sql/issues"
  },
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typedSql": {
    "releaseTrack": "stable"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "test": "poku test --coverage=@pokujs/c8 --coverageConfig=.c8rc.json --reporter=compact --enforce",
    "coverage": "pnpm test"
  },
  "exports": {
    ".": "./dist/packages/conformance/src/index.js",
    "./v2": "./dist/packages/conformance/src/v2/index.js"
  },
  "dependencies": {
    "@typed-sql/compiler": "workspace:*",
    "@typed-sql/core": "workspace:*"
  }
}
