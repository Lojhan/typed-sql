{
  "name": "@typed-sql/postgres",
  "version": "2.5.0",
  "description": "PostgreSQL grammar, schema introspection, type resolution, and driver-neutral runtime codecs for typed-sql.",
  "license": "MIT",
  "author": "Lojhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lojhan/typed-sql.git",
    "directory": "packages/postgres"
  },
  "homepage": "https://github.com/Lojhan/typed-sql#readme",
  "bugs": {
    "url": "https://github.com/Lojhan/typed-sql/issues"
  },
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typedSql": {
    "releaseTrack": "stable",
    "developmentEntrypoints": [
      "./analysis",
      "./reconciliation",
      "./migrations",
      "./analysis/selected",
      "./analysis/profiles/14",
      "./analysis/profiles/15",
      "./analysis/profiles/16",
      "./analysis/profiles/17",
      "./analysis/profiles/18",
      "./analysis/profiles/19"
    ]
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "test": "poku test --coverage=@pokujs/c8 --coverageConfig=.c8rc.json --reporter=compact --enforce",
    "test:soundness": "poku test/soundness.test.ts --reporter=compact --enforce",
    "coverage": "pnpm test"
  },
  "exports": {
    ".": "./dist/packages/postgres/src/index.js",
    "./runtime": "./dist/packages/postgres/src/runtime.js",
    "./pg": "./dist/packages/postgres/src/pg.js",
    "./query": "./dist/packages/postgres/src/query.js",
    "./migrations": "./dist/packages/postgres/src/migrations.js",
    "./profile": "./dist/packages/postgres/src/profile.js",
    "./tag": "./dist/packages/postgres/src/tag.js",
    "./pg-contracts": "./dist/packages/postgres/src/pg-contracts.js",
    "./reconciliation": "./dist/packages/postgres/src/reconciliation.js",
    "./contract-profile": "./dist/packages/postgres/src/contract-profile.js",
    "./analysis": "./dist/packages/postgres/src/analysis.js",
    "./analysis/selected": "./dist/packages/postgres/src/selected-analysis.js",
    "./analysis/profiles/14": "./dist/packages/postgres/src/analysis/generated/14.js",
    "./analysis/profiles/15": "./dist/packages/postgres/src/analysis/generated/15.js",
    "./analysis/profiles/16": "./dist/packages/postgres/src/analysis/generated/16.js",
    "./analysis/profiles/17": "./dist/packages/postgres/src/analysis/generated/17.js",
    "./analysis/profiles/18": "./dist/packages/postgres/src/analysis/generated/18.js",
    "./analysis/profiles/19": "./dist/packages/postgres/src/analysis/generated/19.js"
  },
  "dependencies": {
    "@typed-sql/ast": "workspace:*",
    "@typed-sql/core": "workspace:*",
    "@typed-sql/schema": "workspace:*",
    "@types/pg": "8.23.1",
    "@typed-sql/analysis": "workspace:*"
  },
  "devDependencies": {
    "@typed-sql/conformance": "workspace:*",
    "@typed-sql/migrations": "workspace:*"
  },
  "peerDependencies": {
    "@typed-sql/migrations": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@typed-sql/migrations": {
      "optional": true
    }
  }
}
