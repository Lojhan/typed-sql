{
  "name": "@typed-sql/ts-bridge",
  "version": "2.3.0-rc.2",
  "description": "Experimental TypeScript 7 preview semantic bridge for typed-sql query inference.",
  "license": "MIT",
  "author": "Lojhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lojhan/typed-sql.git",
    "directory": "packages/ts-bridge"
  },
  "homepage": "https://github.com/Lojhan/typed-sql#readme",
  "bugs": {
    "url": "https://github.com/Lojhan/typed-sql/issues"
  },
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typedSql": {
    "releaseTrack": "experimental",
    "typescriptBackend": "typescript-7.1-native-preview",
    "typescriptPreviewVersion": "7.1.0-beta"
  },
  "sideEffects": [
    "./dist/packages/ts-bridge/src/sql-register.js"
  ],
  "type": "module",
  "scripts": {
    "test": "poku test --reporter=compact --enforce",
    "test:soundness": "poku test/soundness.test.ts --reporter=compact --enforce"
  },
  "exports": {
    ".": "./dist/packages/ts-bridge/src/index.js",
    "./native-lsp": "./dist/packages/ts-bridge/src/native-lsp.js",
    "./native-preview": "./dist/packages/ts-bridge/src/native-preview.js",
    "./sql-register": "./dist/packages/ts-bridge/src/sql-register.js",
    "./vite": "./dist/packages/ts-bridge/src/vite.js"
  },
  "dependencies": {
    "@typed-sql/core": "workspace:*",
    "@typed-sql/compiler": "workspace:*",
    "@typed-sql/schema": "workspace:*",
    "@typed-sql/typescript-preview": "npm:typescript@7.1.0-beta",
    "@typed-sql/config": "workspace:*",
    "vscode-jsonrpc": "10.0.0"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "dist/packages/ts-bridge/src/sql-mapper.js"
      ],
      "compilerOptions": [
        "noEmit"
      ],
      "dynamicConfig": true
    }
  },
  "devDependencies": {
    "vite": "6.4.5"
  }
}
