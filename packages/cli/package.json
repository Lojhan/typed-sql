  "description": "Config-driven typed-sql generation, checking, and schema drift CLI.",
  "license": "MIT",
  "author": "Lojhan",
  "repository": { "type": "git", "url": "git+https://github.com/Lojhan/typed-sql.git", "directory": "packages/cli" },
