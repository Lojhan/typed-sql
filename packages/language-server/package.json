{
  "name": "@typed-sql/language-server",
  "version": "2.1.0-rc.1",
  "description": "Experimental grammar-agnostic TypeScript 7 language server for typed-sql.",
  "license": "MIT",
  "author": "Lojhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lojhan/typed-sql.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/Lojhan/typed-sql#readme",
  "bugs": {
    "url": "https://github.com/Lojhan/typed-sql/issues"
  },
  "engines": {
    "node": ">=22.11"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "sdk/**/tsc*",
    "sdk/GO-LICENSE.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "typedSql": {
    "releaseTrack": "experimental",
    "protocolVersion": 1,
    "acceptedProtocolVersions": [
      1
    ],
    "protocolCapabilities": [
      "analysis-identity",
      "diagnostic-fixes",
      "status"
    ],
    "legacyUnversionedProtocolVersion": 1,
    "typescriptPreviewVersion": "7.1.0-beta"
  },
  "type": "module",
  "bin": {
    "typed-sql-language-server": "./dist/packages/language-server/src/server.js",
    "typed-sql-sdk-darwin-arm64": "./sdk/darwin-arm64/tsc",
    "typed-sql-sdk-darwin-x64": "./sdk/darwin-x64/tsc",
    "typed-sql-sdk-linux-arm64": "./sdk/linux-arm64/tsc",
    "typed-sql-sdk-linux-x64": "./sdk/linux-x64/tsc",
    "typed-sql-sdk-win32-arm64": "./sdk/win32-arm64/tsc.exe",
    "typed-sql-sdk-win32-x64": "./sdk/win32-x64/tsc.exe"
  },
  "exports": {
    ".": "./dist/packages/language-server/src/index.js"
  },
  "scripts": {
    "test": "poku test --reporter=compact --enforce",
    "test:soundness": "poku test/soundness.test.ts --reporter=compact --enforce",
    "start": "node dist/packages/language-server/src/server.js --stdio"
  },
  "dependencies": {
    "@typed-sql/config": "workspace:*",
    "@typed-sql/core": "workspace:*",
    "@typed-sql/schema": "workspace:*",
    "@typed-sql/ts-bridge": "workspace:*",
    "vscode-jsonrpc": "10.0.0",
    "vscode-languageserver": "11.0.0",
    "vscode-languageserver-textdocument": "1.0.16"
  }
}
