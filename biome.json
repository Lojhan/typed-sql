{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/bundle",
      "!!**/target",
      "!!**/coverage",
      "!!artifacts",
      "!!test/fixtures/language-audit",
      "!!grammar/catalog/upstream.json",
      "!!grammar/catalog/generation.json",
      "!!grammar/catalog/format.schema.json",
      "!!planning/grammar-completeness/sqlite-keyword-coverage.json",
      "!!planning/grammar-completeness/sqlite-function-coverage.json",
      "!!planning/grammar-completeness/duckdb-routine-projection.json",
      "!!planning/grammar-completeness/postgres-source-coverage.json",
      "!!planning/grammar-completeness/mysql-source-coverage.json",
      "!!planning/grammar-completeness/mysql-routine-projection.json",
      "!!planning/grammar-completeness/sqlserver-source-coverage.json",
      "!!grammar/duckdb/catalog/combinations-*.json",
      "!!grammar/duckdb/facts/catalog.json",
      "!!grammar/postgres/facts/catalog.json",
      "!!grammar/mysql/facts/catalog.json",
      "!!grammar/sqlserver/facts/catalog.json",
      "!!packages/*/src/codecs/generated",
      "!!packages/postgres/src/catalog/generated",
      "!!packages/postgres/src/analysis/generated",
      "!!packages/mysql/src/catalog/generated",
      "!!packages/duckdb/src/catalog/generated",
      "!!packages/duckdb/src/analysis/generated",
      "!!packages/sqlite/src/catalog/generated",
      "!!packages/sqlserver/src/catalog/generated",
      "!!e2e/*/generated",
      "!!examples/**/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["website/.vitepress/theme/styles/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "test/fixtures/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ],
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "yaml": {
    "formatter": {
      "enabled": false
    }
  }
}
